{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciaudit-stress/schemas/prediction.schema.json",
  "title": "SciAudit-Stress prediction object",
  "description": "One system prediction for one Track A instance. Required: instance_id, verdict, confidence, predicted_eids, issue_tags. Abstention and runtime/cost fields are optional but strongly recommended; baselines always emit them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "verdict",
    "confidence",
    "predicted_eids",
    "issue_tags"
  ],
  "properties": {
    "instance_id": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["warranted", "overclaimed", "contradicted", "insufficient"]
    },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "predicted_eids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Evidence IDs the system relied on. Must come from the instance's allowed_evidence_ids."
    },
    "issue_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "numerical_inconsistency",
          "claim_stronger_than_evidence",
          "unsupported_generalization",
          "missing_ablation_support",
          "non_comparable_baseline",
          "weak_statistical_support",
          "evidence_missing_or_incomplete",
          "caption_chart_mismatch"
        ]
      }
    },
    "abstain": { "type": "boolean" },
    "rationale_short": { "type": "string", "maxLength": 600 },
    "runtime_seconds": { "type": "number", "minimum": 0.0 },
    "estimated_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_seconds", "api_cost_usd"],
      "properties": {
        "gpu_seconds": { "type": "number", "minimum": 0.0 },
        "api_cost_usd": { "type": "number", "minimum": 0.0 }
      }
    },
    "system_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "uses_numeric_checker", "uses_lora", "uses_vlm"],
      "properties": {
        "model": { "type": "string" },
        "uses_numeric_checker": { "type": "boolean" },
        "uses_lora": { "type": "boolean" },
        "uses_vlm": { "type": "boolean" }
      }
    }
  }
}
