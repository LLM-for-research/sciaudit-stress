{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciaudit-stress/schemas/track_a_input.schema.json",
  "title": "Публичный входной инстанс Track A, SciAudit-Stress",
  "description": "Вход Track A, видимый участникам и системам: только абстрагированный ID статьи, нормализованный claim и ограниченный evidence pack. additionalProperties:false заодно сторожит от просочившихся приватных полей (gold-вердикт, severity, стресс-метаданные, приватное обоснование, провенанс).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "instance_id",
    "claim",
    "evidence_pack",
    "allowed_evidence_ids"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "paper_id": {
      "type": "string",
      "minLength": 1,
      "description": "Абстрагированный идентификатор статьи (например P017). Названия, авторы, площадки и URL остаются в приватной карте провенанса."
    },
    "instance_id": { "type": "string", "minLength": 1 },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_type", "scope"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "claim_type": {
          "type": "string",
          "enum": [
            "numerical_performance",
            "baseline_superiority",
            "ablation",
            "robustness",
            "efficiency",
            "bounded_generalization"
          ]
        },
        "scope": { "type": "string" }
      }
    },
    "evidence_pack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eid", "source_kind", "modality", "text"],
        "properties": {
          "eid": { "type": "string", "minLength": 1 },
          "source_kind": { "type": "string" },
          "modality": { "type": "string" },
          "text": { "type": "string" },
          "normalized_numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": { "type": "number" },
                "unit": { "type": "string" },
                "context": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "allowed_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Единственные ID evidence, на которые система вправе сослаться в predicted_eids. Обязаны быть подмножеством eid из evidence_pack."
    }
  }
}
