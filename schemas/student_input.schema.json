{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciaudit-stress/schemas/student_input.schema.json",
  "title": "SciAudit-Stress student-facing input object",
  "description": "Only claim + bounded evidence. additionalProperties:false also guards against leaked private fields (e.g. gold/stress).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "claim", "evidence_pack"],
  "properties": {
    "schema_version": { "type": "string" },
    "instance_id": { "type": "string", "minLength": 1 },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_type", "scope"],
      "properties": {
        "text": { "type": "string" },
        "claim_type": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "evidence_pack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eid", "source_kind", "modality", "text"],
        "properties": {
          "eid": { "type": "string" },
          "source_kind": { "type": "string" },
          "modality": { "type": "string" },
          "text": { "type": "string" },
          "normalized_numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": { "type": "number" },
                "unit": { "type": "string" },
                "context": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
