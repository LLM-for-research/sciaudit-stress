# Доступ к модели для бейзлайнов B1-B4 (решение issue #12).
# Скопируйте в .env и заполните. Файл .env в .gitignore и в репозиторий не попадает.
#
# Ключ читается ТОЛЬКО отсюда или из окружения. Он никогда не должен оказаться
# в configs/models.yaml, в командной строке (её видно в ps), в файле предсказаний
# и в логах.

SCIAUDIT_API_KEY=
SCIAUDIT_BASE_URL=https://your-openai-compatible-endpoint/v1
SCIAUDIT_MODEL=your-open-model-id

# Всё остальное (лимит токенов, температура, таймаут) — в configs/models.yaml:
# оно не зависит от эндпоинта и должно лежать в репозитории, а не в .env.
