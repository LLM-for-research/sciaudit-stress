{"schema_version": "track_a_input_v1", "paper_id": "P002", "instance_id": "sas_lbpb27l1", "claim": {"text": "Language-model pretraining reduces in-distribution RMSE for all three chemical foundation models.", "claim_type": "ablation", "scope": "Judge only from the supplied evidence pack."}, "evidence_pack": [{"eid": "e01", "source_kind": "text_span", "modality": "body_text", "text": "Averaged across all ten tasks, pretraining reduces in-distribution RMSE by 31 percent for Model C, 35 percent for Model D and 12 percent for Model E.", "normalized_numbers": [{"value": 31, "unit": "percent", "context": "Model C in-distribution RMSE reduction"}, {"value": 35, "unit": "percent", "context": "Model D in-distribution RMSE reduction"}, {"value": 12, "unit": "percent", "context": "Model E in-distribution RMSE reduction"}]}, {"eid": "e02", "source_kind": "text_span", "modality": "body_text", "text": "All three foundation models improve in-distribution performance across the majority of tasks."}], "allowed_evidence_ids": ["e01", "e02"]}
{"schema_version": "track_a_input_v1", "paper_id": "P002", "instance_id": "sas_79ig3xvb", "claim": {"text": "Language-model pretraining leaves out-of-distribution performance unchanged for all three foundation models.", "claim_type": "ablation", "scope": "Judge only from the supplied evidence pack."}, "evidence_pack": [{"eid": "e01", "source_kind": "text_span", "modality": "body_text", "text": "All three models show a negligible change in average out-of-distribution RMSE due to pretraining."}, {"eid": "e02", "source_kind": "text_span", "modality": "body_text", "text": "Binned out-of-distribution R-squared decreases by 53 percent for Model D and by 39 percent for Model C as a result of pretraining.", "normalized_numbers": [{"value": 53, "unit": "percent", "context": "Model D binned OOD R2 decrease"}, {"value": 39, "unit": "percent", "context": "Model C binned OOD R2 decrease"}]}], "allowed_evidence_ids": ["e01", "e02"]}
{"schema_version": "track_a_input_v1", "paper_id": "P002", "instance_id": "sas_ds2eemmo", "claim": {"text": "Tuning hyperparameters for out-of-distribution performance yields meaningful improvements in OOD generalisation across properties.", "claim_type": "ablation", "scope": "Judge only from the supplied evidence pack."}, "evidence_pack": [{"eid": "e01", "source_kind": "text_span", "modality": "body_text", "text": "Following hyperparameter tuning, out-of-distribution RMSE falls by 60 percent for density, 23 percent for heat of formation and 50 percent for ZPVE.", "normalized_numbers": [{"value": 60, "unit": "percent", "context": "density OOD RMSE reduction"}, {"value": 23, "unit": "percent", "context": "heat of formation OOD RMSE reduction"}, {"value": 50, "unit": "percent", "context": "ZPVE OOD RMSE reduction"}]}, {"eid": "e02", "source_kind": "text_span", "modality": "body_text", "text": "Overall, hyperparameter optimisation is not found to provide meaningful improvements to out-of-distribution performance."}, {"eid": "e03", "source_kind": "text_span", "modality": "body_text", "text": "After tuning, the models are still unable to generalise significantly beyond the training regime."}], "allowed_evidence_ids": ["e01", "e02", "e03"]}
{"schema_version": "track_a_input_v1", "paper_id": "P002", "instance_id": "sas_r1h4er06", "claim": {"text": "Adding augmented out-of-distribution molecules consistently yields sizable generalisation improvements across the eight quantum-chemistry tasks.", "claim_type": "bounded_generalization", "scope": "Judge only from the supplied evidence pack."}, "evidence_pack": [{"eid": "e01", "source_kind": "text_span", "modality": "body_text", "text": "Across 7 of the 8 tasks, generalisation of the graph model improves with augmented data.", "normalized_numbers": [{"value": 7, "unit": "count", "context": "tasks that improve"}, {"value": 8, "unit": "count", "context": "tasks evaluated"}]}, {"eid": "e02", "source_kind": "text_span", "modality": "body_text", "text": "No improvement is observed for the dipole-moment task."}, {"eid": "e03", "source_kind": "text_span", "modality": "body_text", "text": "The 10,000 out-of-distribution examples per property are split into a hold-out test set of 5,000 and up to 5,000 examples that may be added to training."}], "allowed_evidence_ids": ["e01", "e02", "e03"]}
{"schema_version": "track_a_input_v1", "paper_id": "P002", "instance_id": "sas_hekt6a0s", "claim": {"text": "The study reports more than 150 model-task combinations.", "claim_type": "numerical_performance", "scope": "Judge only from the supplied evidence pack."}, "evidence_pack": [{"eid": "e01", "source_kind": "text_span", "modality": "body_text", "text": "Fifteen model architectures are benchmarked.", "normalized_numbers": [{"value": 15, "unit": "count", "context": "model architectures"}]}, {"eid": "e02", "source_kind": "text_span", "modality": "body_text", "text": "Ten property-prediction tasks form the core benchmark.", "normalized_numbers": [{"value": 10, "unit": "count", "context": "core tasks"}]}, {"eid": "e03", "source_kind": "text_span", "modality": "body_text", "text": "An additional experimental-property dataset of 4,200 octanol/water measurements is also benchmarked.", "normalized_numbers": [{"value": 4200, "unit": "count", "context": "experimental measurements"}]}], "allowed_evidence_ids": ["e01", "e02", "e03"]}
